[Unit]
Description=Komunikator, serwer rozmów głosowych
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=komunikator
ExecStart=/usr/local/bin/komunikator-server run --config /etc/komunikator/komunikator.toml
# Katalog /var/lib/komunikator zakłada i oddaje systemd; baza i klucz serwera tylko dla użytkownika usługi.
StateDirectory=komunikator
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2
LimitNOFILE=4096

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/komunikator
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
